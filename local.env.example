# Copy this file to local.env and fill in your values.
# Never commit local.env.

# Name of the session file that stores your login (creates tracker.session)
SESSION_NAME=tracker

# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Account(s) to track: username without @, or numeric user ID
TARGET_USER=
# Optional second account. Leave empty to track only one.
TARGET_USER_2=

# Where to send notifications: "me" (Saved Messages), a username, or a numeric chat ID.
# Leave empty to disable notifications (log file and console only).
DUMP_CHAT=

# Polling interval in seconds
UPDATE_TIME=10
